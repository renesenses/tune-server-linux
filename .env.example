# =============================================================================
# Tune Server v0.6.1 — Configuration
# Copy this file to .env and adjust values for your setup.
# All variables are prefixed with TUNE_ (mapped to Settings fields).
# =============================================================================

# --- Rust Native Acceleration ---
# "auto" = use Rust if available (default), "python" = force Python fallback
#TUNE_SCANNER_ENGINE=auto
#TUNE_DISCOVERY_ENGINE=auto
#TUNE_METADATA_ENGINE=auto

# --- Library ---
# JSON array of music directories to scan
TUNE_MUSIC_DIRS=["~/Music"]
TUNE_SCAN_ON_STARTUP=true
TUNE_WATCH_FILESYSTEM=true

# --- Database ---
# "sqlite" (default, zero config) or "postgres" (recommended for large libraries)
TUNE_DB_ENGINE=sqlite
TUNE_DB_PATH=tune_server.db
# PostgreSQL (uncomment if using postgres):
#TUNE_DB_URL=postgresql://tuneserver:password@localhost/tune
#TUNE_DB_POOL_MIN=2
#TUNE_DB_POOL_MAX=10

# --- Security ---
# API key for authentication (leave empty for no auth — LAN-only servers)
#TUNE_API_KEY=

# --- Server ---
TUNE_API_HOST=0.0.0.0
TUNE_API_PORT=8888
TUNE_STREAM_HOST=0.0.0.0
TUNE_STREAM_PORT=8080

# --- Audio ---
TUNE_DEFAULT_OUTPUT_FORMAT=flac
TUNE_MAX_SAMPLE_RATE=192000
TUNE_MAX_BIT_DEPTH=24
#TUNE_FFMPEG_PATH=ffmpeg
#TUNE_FFPROBE_PATH=ffprobe

# --- Artwork ---
TUNE_ARTWORK_CACHE_DIR=artwork_cache
TUNE_ARTWORK_MAX_SIZE=1200

# =============================================================================
# METADATA ENRICHMENT
# These services fetch artist images, album covers, and metadata corrections.
# All are optional but recommended for a rich library experience.
# =============================================================================

# --- MusicBrainz (FREE, no key needed) ---
# Used automatically for album covers and metadata.
# Rate-limited to 1 request/second.
TUNE_ENRICH_ON_SCAN=true

# --- Discogs (FREE) ---
# Artist images and album metadata.
# Get your token at: https://www.discogs.com/settings/developers
#TUNE_DISCOGS_TOKEN=

# --- Last.fm (FREE) ---
# Artist images, similar artists, play counts.
# Get your API key at: https://www.last.fm/api/account/create
#TUNE_LASTFM_API_KEY=

# --- Radio France (FREE) ---
# Live metadata for FIP, France Inter, France Musique, Mouv'.
# Get your API key at: https://developer.radiofrance.fr
#TUNE_RADIOFRANCE_API_KEY=

# Set to true to prevent Tune from writing tags to audio files
TUNE_METADATA_READONLY=false

# =============================================================================
# STREAMING SERVICES
# Enable the services you subscribe to. Each requires authentication.
# =============================================================================

# --- Tidal (EASIEST — OAuth built-in) ---
# Just enable and log in from the web UI. No keys needed.
TUNE_TIDAL_ENABLED=false
TUNE_TIDAL_QUALITY=LOSSLESS
# Quality options: LOW, HIGH, LOSSLESS, HI_RES_LOSSLESS

# --- Qobuz (EASY — keys included) ---
# Enable and log in from the web UI. App credentials are built-in.
TUNE_QOBUZ_ENABLED=false
# Override defaults only if needed:
#TUNE_QOBUZ_APP_ID=798273057
#TUNE_QOBUZ_APP_SECRET=abb21364945c0583309667d13ca3d93a

# --- Deezer (requires ARL cookie) ---
# 1. Log in to deezer.com in your browser
# 2. Open DevTools (F12) → Application → Cookies → www.deezer.com
# 3. Copy the value of the "arl" cookie
TUNE_DEEZER_ENABLED=false
#TUNE_DEEZER_ARL=paste_your_arl_cookie_here
TUNE_DEEZER_QUALITY=FLAC
# Quality options: FLAC, MP3_320, MP3_128

# --- YouTube Music (requires Google OAuth) ---
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 credentials (Desktop app)
# 4. Copy Client ID and Client Secret below
TUNE_YOUTUBE_ENABLED=false
#TUNE_YOUTUBE_CLIENT_ID=
#TUNE_YOUTUBE_CLIENT_SECRET=
#TUNE_YOUTUBE_API_KEY=

# --- Spotify (requires Developer account) ---
# 1. Go to https://developer.spotify.com/dashboard
# 2. Create an app
# 3. Copy Client ID below
# 4. Add redirect URI: http://localhost:8888/api/v1/streaming/spotify/callback
TUNE_SPOTIFY_ENABLED=false
#TUNE_SPOTIFY_CLIENT_ID=
TUNE_SPOTIFY_REDIRECT_URI=http://localhost:8888/api/v1/streaming/spotify/callback

# --- Amazon Music (API in closed beta — not available yet) ---
TUNE_AMAZON_MUSIC_ENABLED=false
TUNE_AMAZON_MUSIC_REGION=us
TUNE_AMAZON_MUSIC_QUALITY=HD

# =============================================================================
# NETWORK & DISCOVERY
# =============================================================================

# --- Device discovery (DLNA/UPnP + AirPlay) ---
TUNE_DISCOVERY_ENABLED=true
TUNE_SSDP_ENABLED=true
TUNE_MDNS_ENABLED=true

# --- UPnP MediaServer ---
# Tune announces itself on the LAN so DLNA control points can browse your library.
TUNE_UPNP_SERVER_ENABLED=true
TUNE_UPNP_SERVER_NAME=Tune Server

# --- Network shares (SMB/NFS) ---
TUNE_NETWORK_SHARES_ENABLED=false
TUNE_NETWORK_MEDIA_SERVERS_ENABLED=false

# =============================================================================
# LOGGING
# =============================================================================
TUNE_LOG_LEVEL=INFO
# Format: console (human-readable) or json (structured)
TUNE_LOG_FORMAT=console
