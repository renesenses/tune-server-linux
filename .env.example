# Tune Server configuration
# Copy to .env and edit as needed

# Music library directories (JSON array)
# TUNE_MUSIC_DIRS=["~/Music"]

# Database path
# TUNE_DB_PATH=tune_server.db

# Server ports
# TUNE_API_PORT=8888
# TUNE_STREAM_PORT=8080

# Library scanning
# TUNE_SCAN_ON_STARTUP=true
# TUNE_WATCH_FILESYSTEM=true

# Logging
# TUNE_LOG_LEVEL=INFO
# TUNE_LOG_FORMAT=console

# Security (uncomment to require API key)
# TUNE_API_KEY=your-secret-key-here
# TUNE_CORS_ORIGINS=["http://localhost:3000"]

# Tidal
# TUNE_TIDAL_ENABLED=false
# TUNE_TIDAL_QUALITY=HI_RES_LOSSLESS

# Qobuz
# TUNE_QOBUZ_ENABLED=false
# TUNE_QOBUZ_APP_ID=
# TUNE_QOBUZ_APP_SECRET=

# YouTube Music
# TUNE_YOUTUBE_ENABLED=false
# TUNE_YOUTUBE_OAUTH_JSON=

# Amazon Music
# TUNE_AMAZON_MUSIC_ENABLED=false
# TUNE_AMAZON_MUSIC_REGION=us
# TUNE_AMAZON_MUSIC_QUALITY=HD

# Web UI (path to built SPA, empty = disabled)
TUNE_WEB_DIR=/opt/tune-server/web

# Discovery
# TUNE_DISCOVERY_ENABLED=true
# TUNE_SSDP_ENABLED=true
# TUNE_MDNS_ENABLED=true
