# Tune Server configuration
# Copy to .env and edit as needed. All variables use the TUNE_ prefix.

# =============================================================================
# Library
# =============================================================================

# Music library directories (JSON array of absolute paths)
# TUNE_MUSIC_DIRS=["~/Music"]

# Database path (relative to working directory or absolute)
# TUNE_DB_PATH=tune_server.db

# Scan library on startup
# TUNE_SCAN_ON_STARTUP=true

# Watch filesystem for changes (auto-rescan modified directories)
# TUNE_WATCH_FILESYSTEM=true

# Artwork cache directory
# TUNE_ARTWORK_CACHE_DIR=artwork_cache

# =============================================================================
# Server
# =============================================================================

# API server (REST + WebSocket + Web UI)
# TUNE_API_HOST=0.0.0.0
# TUNE_API_PORT=8888

# HTTP audio stream server (for DLNA renderers)
# TUNE_STREAM_HOST=0.0.0.0
# TUNE_STREAM_PORT=8080

# WebSocket heartbeat interval (seconds, 0 to disable)
# TUNE_WS_HEARTBEAT_INTERVAL=30

# Logging
# TUNE_LOG_LEVEL=INFO
# TUNE_LOG_FORMAT=console

# =============================================================================
# Security
# =============================================================================

# API key authentication (uncomment to require X-API-Key header)
# TUNE_API_KEY=your-secret-key-here

# CORS origins (JSON array)
# TUNE_CORS_ORIGINS=["http://localhost:5173"]

# =============================================================================
# Web UI
# =============================================================================

# Path to built SPA (enables embedded web UI on the API port)
TUNE_WEB_DIR=/opt/tune-server/web

# =============================================================================
# Streaming Services
# =============================================================================

# --- Tidal ---
# TUNE_TIDAL_ENABLED=false
# TUNE_TIDAL_QUALITY=HI_RES_LOSSLESS
# Qualities: LOW (AAC 96k), HIGH (AAC 320k), LOSSLESS (FLAC 44.1/16),
#            HI_RES_LOSSLESS (FLAC up to 192/24 — requires HiFi Plus subscription)

# --- Qobuz ---
# TUNE_QOBUZ_ENABLED=false
# TUNE_QOBUZ_APP_ID=
# TUNE_QOBUZ_APP_SECRET=

# --- YouTube (Data API v3 + IFrame Player) ---
# TUNE_YOUTUBE_ENABLED=false
# TUNE_YOUTUBE_CLIENT_ID=          # OAuth 2.0 client ID (Google Cloud Console)
# TUNE_YOUTUBE_CLIENT_SECRET=      # OAuth 2.0 client secret
# TUNE_YOUTUBE_API_KEY=            # Optional: API key for unauthenticated quota

# --- Amazon Music ---
# TUNE_AMAZON_MUSIC_ENABLED=false
# TUNE_AMAZON_MUSIC_REGION=us
# TUNE_AMAZON_MUSIC_QUALITY=HD
# Qualities: SD, HD, ULTRA_HD

# =============================================================================
# Discovery
# =============================================================================

# Enable/disable network device discovery
# TUNE_DISCOVERY_ENABLED=true
# TUNE_SSDP_ENABLED=true
# TUNE_MDNS_ENABLED=true

# =============================================================================
# Network Shares & Media Servers
# =============================================================================

# Enable SMB/NFS share discovery (requires cifs-utils or nfs-common)
# TUNE_NETWORK_SHARES_ENABLED=false

# Enable DLNA MediaServer discovery and browsing
# TUNE_NETWORK_MEDIA_SERVERS_ENABLED=false

# Directory for network share mount points
# TUNE_SMB_MOUNT_DIR=~/.tune/mounts
# Note: requires sudo mount/umount permissions (see docs/linux.md)
