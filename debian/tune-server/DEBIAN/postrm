#!/bin/bash
set -e

case "$1" in
    remove)
        # Disable the service
        systemctl disable tune-server.service 2>/dev/null || true
        systemctl daemon-reload
        ;;

    purge)
        # Disable the service
        systemctl disable tune-server.service 2>/dev/null || true
        systemctl daemon-reload

        # Remove the system user
        if getent passwd tune-server > /dev/null 2>&1; then
            deluser --system tune-server 2>/dev/null || true
        fi
        if getent group tune-server > /dev/null 2>&1; then
            delgroup --system tune-server 2>/dev/null || true
        fi

        # Clean up data directory (venv, db, cache)
        rm -rf /opt/tune-server
        ;;
esac

# Automatically added by dh_installsystemd/13.14.1ubuntu5
if [ "$1" = remove ] && [ -d /run/systemd/system ] ; then
	systemctl --system daemon-reload >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.14.1ubuntu5
if [ "$1" = "purge" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper purge 'tune-server.service' >/dev/null || true
	fi
fi
# End automatically added section


exit 0
